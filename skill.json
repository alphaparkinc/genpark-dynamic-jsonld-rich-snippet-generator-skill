{
  "name": "genpark-dynamic-jsonld-rich-snippet-generator-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Generative Schema.org Product and FAQPage JSON-LD rich snippet generator optimizing search engine microdata indexing.",
  "homepage": "https://genpark.ai/mcp",
  "author": "alphaparkinc",
  "category": "search-seo",
  "tags": [
    "json-ld",
    "schema-org",
    "rich-snippets",
    "seo-optimization",
    "microdata"
  ],
  "inputs": {
    "product_title": {
      "type": "string",
